{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinicex-boite-mystere",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinicex-db",
      "database_id": "REMPLACER_PAR_ID_D1"
    }
  ]
}